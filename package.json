{
  "name": "personal-finance-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"db/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \".github/**/*.yml\" \".secretlintrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"db/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \".github/**/*.yml\" \".secretlintrc.json\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions react-server scripts/migrate.ts",
    "recurring:run": "tsx --conditions react-server scripts/run-recurring.ts",
    "verify:clean-migrations": "tsx scripts/verify-clean-migrations.ts",
    "verify:build-without-database": "tsx scripts/verify-build-without-database.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:secrets": "secretlint --format github \"**/*\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run verify:clean-migrations && npm run verify:build-without-database && npm run security:secrets"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "secretlint": "^13.0.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
