# Local development values. Copy to .env and adjust; never commit .env.
# Compose overrides DATABASE_PATH with the container volume path, so the same
# file serves local runs and the private deployment.
DATABASE_PATH=./data/personal-finance.db
APP_URL=http://localhost:3000
TZ=Europe/Madrid

# Encrypted backup. BACKUP_PATH is the private staging directory where the
# snapshot is built and deleted again; the artifact is uploaded to
# BACKUP_DESTINATION_URI. Only a file:// destination is implemented: the
# provider, path and key of a real deployment need the owner's decision.
# BACKUP_ENCRYPTION_KEY_FILE is an absolute path to an owner-only file holding
# the base64 AES-256 key. Never place the key itself in this file, in .env or
# in any environment value.
BACKUP_PATH=./backups
BACKUP_DESTINATION_URI=file:///srv/personal-finance-backups
BACKUP_ENCRYPTION_KEY_FILE=/etc/personal-finance-tracker/backup.key

# Interface and port of the Node server. The default bind is loopback; a
# non-loopback HOST additionally requires ALLOW_NON_LOOPBACK_BIND=true, which
# only the container sets because Compose publishes on the host loopback.
HOST=127.0.0.1
PORT=3000

# Host loopback port published by Compose for the container.
APP_PORT=3000
